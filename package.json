{
  "name": "issue-runner-core",
  "version": "0.0.0-contract.1",
  "description": "Issue Runner CLI startup and public terminal plugin contract",
  "type": "module",
  "exports": {
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "default": "./dist/terminal.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "skills/issue-runner-handoff",
    "docs/terminal-contract.md",
    "docs/configuration.md"
  ],
  "bin": {
    "issue-runner": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\" \"tests/run/*.test.ts\"",
    "test:package": "node --test tests/package.test.mjs",
    "prepack": "npm run build",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.10.0",
    "globals": "17.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "cac": "7.0.0",
    "yaml": "2.9.1"
  }
}
